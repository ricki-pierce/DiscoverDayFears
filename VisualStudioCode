import sounddevice as sd
import soundfile as sf
import os
from datetime import datetime
import pytz
import pandas as pd
from pupil_labs.realtime_api.simple import discover_one_device

# ───────── CONFIG ─────────
SERIAL_PORT = 'COM4'
BAUD_RATE = 115200
BEEP_FILE = r"C:\Users\nfears\Downloads\500Hz500mstone.wav"
WORK_DIR = r"C:\Users\nfears\Downloads"
TIMEZONE = pytz.timezone('America/Chicago')
NUM_BUTTONS = 4

os.chdir(WORK_DIR)

# ───────── GLOBALS ─────────
arduino = None
current_button = None
event_log = []
press_times = {}
running = False
neon_device = None

# ───────── TIME HELPERS ─────────
def now_central():
    return datetime.now(TIMEZONE)

def ts():
    return now_central().strftime('%H:%M:%S.%f')[:-3]

# ───────── ARDUINO SETUP ─────────
try:
    arduino = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)
    time.sleep(2)
    print(f"[ARDUINO] Connected on {SERIAL_PORT}")
except serial.SerialException as e:
    print(f"[ARDUINO] Could not open {SERIAL_PORT}: {e}")
    arduino = None

# ───────── NEON FUNCTIONS ─────────
def discover_neon(timeout=10):
    from pupil_labs.realtime_api.simple import Device

    # Replace with the actual IP address of your phone
    # Port 8080 is the default for Neon
    device = Device(address="167.96.71.118", port=8080)

    print(f"Connected to {device.phone_name}")
    if device:
        print("[NEON] Device connected.")
    else:
        print("[NEON] No device found — continuing without eye tracking.")
    return device

async def neon_start_recording(device):
    if not device:
        return None
    try:
        await asyncio.to_thread(device.recording_start)
        print("[NEON] Recording started.")
        try:
            offset_result = await asyncio.to_thread(device.estimate_time_offset)
            phone_to_pc_time_offset_ms = offset_result.time_offset_ms.mean
            print(f"[NEON] Phone-to-PC time offset: {phone_to_pc_time_offset_ms} ms")
        except Exception as e:
            print(f"[NEON] Could not get time offset: {e}")
            phone_to_pc_time_offset_ms = None
        return phone_to_pc_time_offset_ms
    except Exception as e:
        print(f"[NEON] Failed to start recording: {e}")
        return None

async def neon_stop_recording(device):
    if not device:
        return
    try:
        await asyncio.to_thread(device.recording_stop_and_save)
        print("[NEON] Recording stopped and saved.")
    except Exception as e:
        print(f"[NEON] Failed to stop recording: {e}")

# ───────── BEEP ─────────
def play_beep():
    if not os.path.exists(BEEP_FILE):
        print(f"[BEEP] File not found: {BEEP_FILE}")
        return
    data, fs = sf.read(BEEP_FILE, dtype='float32')
    sd.play(data, fs)
    sd.wait()

# ───────── ARDUINO SERIAL THREAD ─────────
def serial_listener():
    global current_button, press_times, event_log
    while True:
        if arduino and arduino.in_waiting > 0:
            line = arduino.readline().decode(errors='ignore').strip()
            if not line:
                continue
            parts = line.split()
            if len(parts) != 2:
                continue
            event, arduino_ms_str = parts[0], parts[1]
            try:
                arduino_ms = int(arduino_ms_str)
            except ValueError:
                continue
            system_time = ts()
            button = event.split("_")[1] if "_" in event else None

            if "_pressed" in event:
                press_times[button] = arduino_ms
                event_log.append({
                    'Button Lit': current_button,
                    'Lit Time': event_log[-1]['Lit Time'] if event_log else None,
                    'Button Pressed': button,
                    'Press Time': system_time,
                    'Duration (ms)': None
                })
                # Turn off the LED if pressed
                if current_button is not None and arduino:
                    arduino.write(f"LED_{current_button}_OFF\n".encode())
                    current_button = None

            elif "_released" in event:
                if button in press_times:
                    duration = arduino_ms - press_times[button]
                    # Find the corresponding log entry to add duration
                    for entry in reversed(event_log):
                        if entry['Button Pressed'] == button and entry['Duration (ms)'] is None:
                            entry['Duration (ms)'] = duration
                            break
                    del press_times[button]

# ───────── BUTTON LIGHTING LOOP ─────────
def button_loop():
    global current_button, running, event_log
    button_pool = list(range(1, NUM_BUTTONS + 1))

    while running:
        if not button_pool:
            button_pool = list(range(1, NUM_BUTTONS + 1))
        current_button = random.choice(button_pool)
        button_pool.remove(current_button)

        # 500ms delay before beep
        time.sleep(0.5)

        # Play beep first
        play_beep()  # This will block until the beep finishes

        # Then light the LED
        if arduino:
            arduino.write(f"LED_{current_button}_ON\n".encode())
            arduino.flush()

        lit_time = ts()
        event_log.append({
            'Button Lit': current_button,
            'Lit Time': lit_time,
            'Button Pressed': None,
            'Press Time': None,
            'Duration (ms)': None
        })

        # Wait until button pressed
        while running and current_button is not None:
            time.sleep(0.01)

        # 2-second delay before next button
        time.sleep(2)

# ───────── GUI FUNCTIONS ─────────
def start_experiment():
    global running
    if running:
        return
    running = True
    threading.Thread(target=button_loop, daemon=True).start()
    if neon_device:
        asyncio.run(neon_start_recording(neon_device))

def stop_experiment():
    global running, current_button
    running = False
    # Turn off any lit LED
    if current_button and arduino:
        arduino.write(f"LED_{current_button}_OFF\n".encode())
        current_button = None
    if neon_device:
        asyncio.run(neon_stop_recording(neon_device))

def on_closing():
    stop_experiment()
    if event_log:
        df = pd.DataFrame(event_log)
        subject_id = subject_id_entry.get().strip() or "Unknown"
        filename = f"trial_log_{datetime.now().strftime('%Y%m%d_%H%M%S')}_{subject_id}.xlsx"
        df.to_excel(filename, index=False)
        print(f"[EXCEL] Saved → {filename}")
    root.destroy()

# ───────── MAIN GUI ─────────
root = tk.Tk()
root.title("Button Experiment")

tk.Label(root, text="Subject ID:").pack(pady=5)
subject_id_entry = tk.Entry(root)
subject_id_entry.pack(pady=5)

start_btn = tk.Button(root, text="START", bg="green", fg="white", width=10, command=start_experiment)
start_btn.pack(pady=10)

stop_btn = tk.Button(root, text="STOP", bg="red", fg="white", width=10, command=stop_experiment)
stop_btn.pack(pady=10)

root.protocol("WM_DELETE_WINDOW", on_closing)

# Start serial listener thread
threading.Thread(target=serial_listener, daemon=True).start()

# Discover Neon glasses
neon_device = discover_neon()

root.mainloop()
